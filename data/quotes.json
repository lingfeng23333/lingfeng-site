[
  { "text": "人没有牺牲就什么都得不到，为了得到什么东西，就必须付出同等的代价。", "character": "爱德华·艾尔利克", "source": "钢之炼金术师" },
  { "text": "错的不是我，而是这个世界。", "character": "金木研", "source": "东京喰种" },
  { "text": "我是要成为海贼王的男人！", "character": "蒙奇·D·路飞", "source": "海贼王" },
  { "text": "明天的我，会比今天的我更强。", "character": "埼玉", "source": "一拳超人" },
  { "text": "如果结果不如你所愿，就在尘埃落定前奋力一搏。", "character": "夏目贵志", "source": "夏目友人帐" },
  { "text": "世界并不美丽，但也因此美丽非凡。", "character": "银古", "source": "虫师" },
  { "text": "只有拥有力量的人，才有资格谈论正义。", "character": "鲁路修·兰佩路基", "source": "反叛的鲁路修" },
  { "text": "不是成为火影的人被大家认可，而是被大家认可的人才能成为火影。", "character": "宇智波鼬", "source": "火影忍者" },
  { "text": "我很好奇！", "character": "千反田爱瑠", "source": "冰菓" },
  { "text": "没必要做的事就不做，必要做的事尽快做。", "character": "折木奉太郎", "source": "冰菓" },
  { "text": "在虚构的故事当中寻找真实感的人，脑子一定有问题。", "character": "阿虚", "source": "凉宫春日的忧郁" },
  { "text": "想要拯救某个人，就要做好牺牲其他人的觉悟。", "character": "卫宫切嗣", "source": "Fate/Zero" },
  { "text": "只要是活着的东西，就算是神也杀给你看。", "character": "两仪式", "source": "空之境界" },
  { "text": "我不再祈求奇迹，而是创造奇迹。", "character": "鹿目圆", "source": "魔法少女小圆" },
  { "text": "选择吧。后悔，是留给活着的人的。", "character": "利威尔·阿克曼", "source": "进击的巨人" },
  { "text": "绝对没问题！", "character": "木之本樱", "source": "魔卡少女樱" },
  { "text": "我是天才！", "character": "樱木花道", "source": "灌篮高手" },
  { "text": "白痴。", "character": "流川枫", "source": "灌篮高手" },
  { "text": "与其想着怎样华丽地死去，不如想想怎样华丽地活下去吧！", "character": "坂田银时", "source": "银魂" },
  { "text": "爆裂吧，现实！粉碎吧，精神！放逐这个世界！", "character": "小鸟游六花", "source": "中二病也要谈恋爱！" },
  { "text": "只有强者，才有资格使用温柔这个词。", "character": "比企谷八幡", "source": "我的青春恋爱物语果然有问题" },
  { "text": "憧憬，是距离理解最遥远的感情。", "character": "蓝染惣右介", "source": "死神" },
  { "text": "为了你，我宁愿重复无数次轮回。", "character": "晓美焰", "source": "魔法少女小圆" },
  { "text": "不管你在世界的哪里，我都会再去见你一次。", "character": "宫水三叶", "source": "你的名字。" }
]
