# Bangumi 个人 Access Token
# 在 https://next.bgm.tv/demo/access-token 生成，注意保密、定期更换
BANGUMI_TOKEN=

# Bangumi 用户名（当前账号无自定义 slug，保持默认即可）
BANGUMI_USERNAME=966130

# 站点 URL，用于 sitemap 和 RSS
NEXT_PUBLIC_SITE_URL=https://lingfeng.example.com

# 可选：站内写回 Bangumi 接口的简单鉴权
# 配置后，请求需带请求头 x-site-secret；不配置则不做校验
SITE_EDIT_SECRET=

# 可选：远程随机壁纸 API
# 返回 JSON 且含 urls.regular / url 字段即可，例如：
# WALLPAPER_API=https://api.lolicon.app/setu/v2?r18=0&num=1&size=regular
WALLPAPER_API=

# 可选：同步脚本的 User-Agent
BANGUMI_USER_AGENT=LingFengSite/0.1 (personal site)
